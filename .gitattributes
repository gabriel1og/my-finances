# Normaliza fim de linha: LF no repositório, conversão automática no checkout.
# Sem isto, README.md, package.json e package-lock.json apareciam modificados
# em todo git status por causa de CRLF no Windows.
* text=auto eol=lf

# Binários — nunca converter.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
